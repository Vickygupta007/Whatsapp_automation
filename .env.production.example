# ==============================================================================
# WhatsApp Optical ERP Automation - Production Environment Variables Template
# ==============================================================================
NODE_ENV=production
PORT=3000
CORS_ORIGIN=*

# Disable local ngrok when deployed on cloud platform (Render/Railway/VPS provides SSL domain)
NGROK_ENABLED=false

# Production PostgreSQL Database Connection
DATABASE_URL=postgresql://user:password@host:5432/whatsapp_rio_erp?schema=public

# WhatsApp Cloud API Credentials (Meta Developer Portal)
# https://developers.facebook.com/apps/
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_or_system_user_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_secret_verify_token
WHATSAPP_USE_MOCK=false

# Google Gemini Vision AI (Prescription OCR & Lens Parameter Extraction)
GEMINI_API_KEY=your_gemini_api_key

# Rio Optical ERP Client Configuration
RIO_ERP_BASE_URL=http://200.234.35.179:3000
RIO_ERP_API_KEY=rio_whatsapp_secret_key_2026
RIO_ERP_AUTH_TYPE=api-key
RIO_ERP_USE_MOCK=true
