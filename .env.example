# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For local SQLite testing (optional fallback): file:./dev.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_rio_erp?schema=public"

# Rio ERP Integration Configuration
# Configure these when connecting to your live or staging Rio ERP environment
RIO_ERP_BASE_URL=https://api.rioerp.example.com
RIO_ERP_API_KEY=your_rio_erp_api_key_here
RIO_ERP_USERNAME=your_rio_erp_username
RIO_ERP_PASSWORD=your_rio_erp_password
# Auth Type: 'api-key' | 'bearer' | 'basic'
RIO_ERP_AUTH_TYPE=api-key
# Enable mock responses when developing locally without active Rio ERP connection ('true' or 'false')
RIO_ERP_USE_MOCK=true

# Meta WhatsApp Cloud API Configuration
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
# Enable mock WhatsApp delivery (logs to console/db instead of calling Graph API) ('true' or 'false')
WHATSAPP_USE_MOCK=true

# Notification & Template Messages
MSG_UNREGISTERED_CUSTOMER="Your WhatsApp number is not registered with our system. Please contact support/customer service to register your account."
MSG_INVALID_ORDER_HELP="Please send your order in the required format. Example: Product, lens type, coating, index and prescription details (e.g., R: -1.50 L: -2.00 Bluecut 1.56 Ref: Sharma)."
MSG_ORDER_CONFIRMATION_TEMPLATE="Order Placed: {orderId}\nAccount: {accountName}\nProduct: {product}\nRef: {customerRef}\n\nYour work order has been queued in Rio ERP."
